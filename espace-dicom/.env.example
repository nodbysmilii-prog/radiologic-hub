# =====================================================================
# Espace DICOM — configuration du serveur
# Copie : node outils/initialiser.js crée .env à partir de ce fichier et
# génère les secrets internes. Le fichier .env n'est jamais publié (git).
# Tout ce qui dépend du domaine ou de l'hébergeur est ici : changer de
# domaine ou d'hébergeur ne demande aucune modification du code.
# =====================================================================

# ---------- Adresse publique ----------
# Nom de domaine du serveur d'images (un sous-domaine, ex. dicom.mon-domaine.tn).
# En local : dicom.localhost (les navigateurs le dirigent vers 127.0.0.1).
DICOM_DOMAINE=dicom.localhost
# Adresse complète vue des navigateurs (avec le port s'il n'est pas 443).
DICOM_URL_PUBLIQUE=https://dicom.localhost:8443
# Sites autorisés à appeler l'API et à afficher la visionneuse, séparés par des espaces
# (aujourd'hui le site est sur GitHub Pages ; à changer avec le domaine du site).
DICOM_SITE_ORIGINES=https://nodbysmilii-prog.github.io http://localhost:8000

# ---------- Ports publiés par Nginx ----------
# Interface : 127.0.0.1 en local (poste seul) ; 0.0.0.0 sur le VPS.
PUBLIER_SUR=127.0.0.1
PORT_HTTP=8080
PORT_HTTPS=8443

# ---------- Dossiers ----------
# Images, index d'Orthanc et certificats Let's Encrypt : LE dossier à sauvegarder
# et à copier pour changer d'hébergeur.
DONNEES_DIR=./donnees
# Certificat HTTPS (fullchain.pem et privkey.pem).
CERTS_DIR=./certs
# Taille maximale du cache d'images de Nginx.
DICOM_CACHE_TAILLE=20g

# ---------- Supabase (comptes et droits) ----------
# Adresse du projet (Réglages > API). Les mêmes valeurs que remplacements/config.js.
SUPABASE_URL=
# Clé « anon » ou « publishable » (publique).
SUPABASE_CLE_PUBLIQUE=
# Clé « service_role » ou « secret » : SERVEUR SEULEMENT, jamais dans le site.
SUPABASE_CLE_SERVICE=
# Secret JWT, seulement pour les projets à clé symétrique (ancienne formule) ;
# sinon laisser vide : les clés publiques du projet (JWKS) sont utilisées.
SUPABASE_JWT_SECRET=
# Durée pendant laquelle un droit vérifié est gardé en mémoire (secondes).
# Un retrait de droit prend effet après ce délai au plus.
DROITS_CACHE_SECONDES=60

# ---------- Secrets internes (générés par outils/initialiser.js) ----------
ORTHANC_UTILISATEUR=dicomapi
ORTHANC_MOT_DE_PASSE=
ORTHANC_DB_MOT_DE_PASSE=
